# Server Configuration
PORT=5000
NODE_ENV=development

# Session Security (REQUIRED: replace with a strong random secret before production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_session_secret_at_least_32_chars

# CORS Allowed Origin
FRONTEND_ORIGIN=http://localhost:5000

# Admin provisioning (development)
# Provision / reset the admin account from these environment variables on startup.
# ADMIN_PASSWORD must be at least 12 characters in production.
# Never commit real values. Do not use these placeholder credentials in production.
ADMIN_EMAIL=admin@turfarena.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password_min_12_chars

# Optional: SQLite session-store location (defaults to backend/sessions.db)
# SESSION_DB_NAME=sessions.db
# SESSION_DB_DIR=.
